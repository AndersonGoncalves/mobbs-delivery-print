# URL do BFF do mobbs-delivery (produção: https://api.bsdelivery.com.br).
BFF_URL=https://api.bsdelivery.com.br

# Chave de API do restaurante — gerada na retaguarda web, em
# "Configurações" > "Impressão automática" > "Gerar chave".
PRINT_API_KEY=

# Como o node-thermal-printer alcança a impressora térmica:
#   - Windows (recomendado): printer:NomeDaImpressora
#     (o nome exato como aparece em "Impressoras e scanners" do Windows)
#   - Linux via CUPS:        printer:NomeDaImpressora
#   - Linux, dispositivo USB bruto: /dev/usb/lp0 (ajuste conforme o seu sistema)
#   - Impressora de rede:    tcp://192.168.0.100
PRINTER_INTERFACE=printer:POS-80

# "epson" (a grande maioria das térmicas de 80mm não fiscais) ou "star".
PRINTER_TYPE=epson

# specs/0147-impressao-manual-direta-bridge — porta do servidor local que permite o botão
# "Imprimir" manual da retaguarda imprimir direto (sem diálogo), em vez de cair no window.print()
# do navegador. Opcional — padrão 48201. Só mude se já tiver outro programa usando essa porta
# nesse computador.
# LOCAL_PRINT_SERVER_PORT=48201
