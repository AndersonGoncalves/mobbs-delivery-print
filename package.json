{
  "name": "mobbs-delivery-print",
  "version": "1.0.0",
  "description": "Serviço local (Windows/Linux) que imprime a comanda de pedidos de delivery/retirada assim que são confirmados, consultando o BFF do mobbs-delivery em intervalo configurável (specs/0139-impressao-automatica-bridge).",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "package:win": "pkg . --targets node20-win-x64 --output mobbs-delivery-print-win.exe",
    "package:linux": "pkg . --targets node20-linux-x64 --output mobbs-delivery-print-linux"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.5",
    "node-thermal-printer": "^4.5.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@yao-pkg/pkg": "^6.14.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "targets": [
      "node20-win-x64",
      "node20-linux-x64"
    ]
  }
}
